# Create .env with `node scripts/init-env.mjs` (it generates the secrets below). Never commit .env.

# --- Runtime ---
LOG_LEVEL=info
# Where the BROWSER reaches the API (baked into the web image at build time). Must be same-site as WEB_ORIGIN.
PUBLIC_API_URL=http://localhost:4400/api/v1
WEB_ORIGIN=http://localhost:3000

# --- Secrets (generated by scripts/init-env.mjs) ---
POSTGRES_PASSWORD=change-me
# Signs session cookies. At least 32 characters.
SESSION_SECRET=change-me-to-at-least-32-random-characters
# Envelope-encryption master keys: "kid:base64(32 bytes)", comma separated.
# The FIRST entry encrypts new data; keep older entries so existing files still decrypt
# (see docs/runbook.md for rotation). Back this up: losing it makes encrypted files unrecoverable.
MASTER_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES

# --- Storage backend ---
# google | fake   (fake = in-memory, dev/test only; data is lost on restart)
STORAGE_PROVIDER=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an authorised redirect URI in the Google Cloud console.
GOOGLE_REDIRECT_URI=http://localhost:4400/api/v1/accounts/google/callback

# --- Storage tuning ---
# Chunk size for files that do not fit in a single account (default 64 MiB).
CHUNK_SIZE_BYTES=67108864
# Encrypted files are stored in smaller records: each is held in memory whole when downloaded.
ENCRYPTED_CHUNK_BYTES=16777216
# Never fill an account beyond (100 - HEADROOM_PERCENT)%, and always keep at least HEADROOM_MIN_BYTES free.
HEADROOM_PERCENT=5
HEADROOM_MIN_BYTES=100000000
QUOTA_SYNC_INTERVAL_SECONDS=300
TRASH_RETENTION_DAYS=30

# --- Features / observability ---
# TOTP 2FA (stub).
FEATURE_TOTP=false
# Optional, Sentry-compatible error tracking.
SENTRY_DSN=
# Optional: require "Authorization: Bearer <token>" (min 16 chars) on /metrics.
METRICS_TOKEN=
